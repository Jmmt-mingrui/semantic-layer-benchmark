{
  "schema_version": "0.1.0",
  "catalog": "blank_context",
  "tools": [
    {
      "name": "db.list_relations",
      "description": "List relations visible in one database schema. This is metadata discovery and does not return rows.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {"type": "string", "minLength": 1}
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relations"],
        "properties": {
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "name", "type"],
              "properties": {
                "schema": {"type": "string"},
                "name": {"type": "string"},
                "type": {"enum": ["table", "view"]}
              }
            }
          }
        }
      }
    },
    {
      "name": "db.describe_relations",
      "description": "Return physical columns, types, nullability, and declared keys for named relations. It adds no business descriptions or inferred joins.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relations"],
        "properties": {
          "relations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relations"],
        "properties": {
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "name", "columns"],
              "properties": {
                "schema": {"type": "string"},
                "name": {"type": "string"},
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "data_type", "nullable"],
                    "properties": {
                      "name": {"type": "string"},
                      "data_type": {"type": "string"},
                      "nullable": {"type": "boolean"},
                      "key_role": {"enum": ["primary", "unique", "foreign", "none"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "db.execute_readonly",
      "description": "Execute candidate read-only SQL on the pinned snapshot. Mutating, administrative, external-I/O, extension, and undeclared multi-statement SQL is rejected before execution.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sql"],
        "properties": {
          "sql": {"type": "string", "minLength": 1},
          "parameters": {"type": "array", "items": {}}
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_handle", "columns", "row_count", "result_sha256", "elapsed_ms", "preview_rows"],
        "properties": {
          "result_handle": {"type": "string", "minLength": 1},
          "columns": {"type": "array", "items": {"type": "string"}},
          "row_count": {"type": "integer", "minimum": 0},
          "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "elapsed_ms": {"type": "number", "minimum": 0},
          "preview_rows": {
            "type": "array",
            "maxItems": 20,
            "description": "A bounded preview for agent self-checking; full rows stay in the result artifact.",
            "items": {"type": "array"}
          }
        }
      }
    },
    {
      "name": "benchmark.submit_result",
      "description": "Submit the final status exactly once. A successful submission references result handles produced in this trial.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"enum": ["success", "unsupported", "failed"]},
          "result_handles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "success"}}},
            "then": {"required": ["result_handles"]},
            "else": {"required": ["reason"]}
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": {"type": "boolean"}
        }
      }
    }
  ]
}

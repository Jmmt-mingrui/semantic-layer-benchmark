{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-layer-benchmark.local/schemas/experiment.schema.json",
  "title": "Semantic layer benchmark experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "lane",
    "protocol_revision",
    "workload",
    "dataset",
    "agent",
    "targets",
    "execution",
    "isolation",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "description": {"type": "string", "minLength": 1},
    "lane": {
      "enum": [
        "native_end_to_end",
        "native_serving",
        "controlled_context_ablation",
        "semantic_structure"
      ]
    },
    "protocol_revision": {"type": "string", "minLength": 1},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark", "scale_factor", "question_instances", "question_ids"],
      "properties": {
        "benchmark": {"const": "TPC-DS-derived"},
        "scale_factor": {"type": "integer", "minimum": 1},
        "question_instances": {"$ref": "#/$defs/path"},
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^q(?:0[1-9]|[1-9][0-9])$"}
        },
        "unresolved_parameter_policy": {"const": "reject"},
        "multi_statement_policy": {"enum": ["declared_group_only", "reject_all"]}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "database_config", "read_only"],
      "properties": {
        "manifest": {"$ref": "#/$defs/path"},
        "database_config": {"$ref": "#/$defs/path"},
        "read_only": {"const": true},
        "snapshot_sha256": {"$ref": "#/$defs/sha256OrEnv"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "system_prompt",
        "user_prompt_template",
        "fresh_conversation_per_trial",
        "generation"
      ],
      "properties": {
        "provider": {"$ref": "#/$defs/envRef"},
        "model": {"$ref": "#/$defs/envRef"},
        "model_revision": {"$ref": "#/$defs/envRef"},
        "system_prompt": {"$ref": "#/$defs/path"},
        "user_prompt_template": {"$ref": "#/$defs/path"},
        "fresh_conversation_per_trial": {"const": true},
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "max_output_tokens", "max_turns"],
          "properties": {
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "seed": {"type": ["integer", "null"]},
            "max_output_tokens": {"type": "integer", "minimum": 1},
            "max_turns": {"type": "integer", "minimum": 1},
            "parallel_tool_calls": {"type": "boolean"}
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "include", "native_only"],
      "properties": {
        "registry": {"$ref": "#/$defs/path"},
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["blank_context", "ddl_only", "metricflow", "cube", "ossie", "okf", "skill"]
          }
        },
        "native_only": {"const": true},
        "fallback_policy": {"const": "record_unsupported_no_fallback"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "question_order", "target_order", "timeouts", "cache_mode"],
      "properties": {
        "repetitions": {"type": "integer", "minimum": 1},
        "question_order": {"enum": ["randomized", "fixed"]},
        "target_order": {"enum": ["randomized", "fixed"]},
        "random_seed": {"type": "integer"},
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trial_seconds", "tool_seconds", "database_seconds"],
          "properties": {
            "trial_seconds": {"type": "integer", "minimum": 1},
            "tool_seconds": {"type": "integer", "minimum": 1},
            "database_seconds": {"type": "integer", "minimum": 1}
          }
        },
        "cache_mode": {"enum": ["correctness_uncached", "cold", "warm"]},
        "max_database_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold_assets", "cross_trial_memory", "target_network"],
      "properties": {
        "gold_assets": {"const": "evaluator_only"},
        "gold_results": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^q(?:0[1-9]|[1-9][0-9])$"},
          "additionalProperties": {"$ref": "#/$defs/path"}
        },
        "cross_trial_memory": {"const": "disabled"},
        "target_network": {"enum": ["disabled", "allowlisted_native_endpoint_only"]},
        "secrets_in_prompts": {"const": false},
        "mid_trial_hints": {"const": false}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_directory", "save_sanitized_conversation", "save_native_requests", "save_sql"],
      "properties": {
        "run_directory": {"$ref": "#/$defs/path"},
        "save_sanitized_conversation": {"const": true},
        "save_native_requests": {"const": true},
        "save_sql": {"const": true},
        "save_result_rows": {"type": "boolean"},
        "save_result_hash": {"const": true}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1},
    "envRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env", "required"],
      "properties": {
        "env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "required": {"type": "boolean"},
        "default": {"type": ["string", "number", "boolean", "null"]}
      }
    },
    "sha256OrEnv": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"$ref": "#/$defs/envRef"}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-layer-benchmark.local/schemas/trial-record.schema.json",
  "title": "Benchmark trial record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "trial_id",
    "experiment_id",
    "question",
    "condition",
    "conversation",
    "native_execution",
    "candidate",
    "evaluation",
    "usage",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "instance_id", "target_prompt_sha256"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q(?:0[1-9]|[1-9][0-9])$"},
        "instance_id": {"type": "string", "minLength": 1},
        "target_prompt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "lane", "repetition", "native_surface", "artifact_sha256"],
      "properties": {
        "target": {
          "enum": ["blank_context", "ddl_only", "metricflow", "cube", "ossie", "okf", "skill"]
        },
        "lane": {"enum": ["native_end_to_end", "native_serving", "controlled_context_ablation"]},
        "repetition": {"type": "integer", "minimum": 1},
        "native_surface": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh",
        "system_prompt_sha256",
        "tool_schema_sha256",
        "sanitized_transcript",
        "message_count"
      ],
      "properties": {
        "fresh": {"const": true},
        "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "tool_schema_sha256": {"$ref": "#/$defs/sha256"},
        "sanitized_transcript": {"type": "string", "minLength": 1},
        "message_count": {"type": "integer", "minimum": 2},
        "provider_conversation_id": {"type": ["string", "null"]},
        "provider_response_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "native_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used_only_declared_surface", "requests", "fallback_used"],
      "properties": {
        "used_only_declared_surface": {"type": "boolean"},
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "status", "duration_ms"],
            "properties": {
              "operation": {"type": "string", "minLength": 1},
              "request_artifact": {"type": ["string", "null"]},
              "response_artifact": {"type": ["string", "null"]},
              "status": {"enum": ["ok", "error", "timeout", "unsupported"]},
              "duration_ms": {"type": "number", "minimum": 0}
            }
          }
        },
        "fallback_used": {"const": false},
        "unsupported_reason": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_count", "sql_artifacts", "result_artifacts"],
      "properties": {
        "statement_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "sql_artifacts": {"type": "array", "items": {"type": "string"}},
        "result_artifacts": {"type": "array", "items": {"type": "string"}},
        "answer_artifact": {"type": ["string", "null"]}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_success", "result_equivalent", "reference_result_sha256", "error_category"],
      "properties": {
        "execution_success": {"type": "boolean"},
        "result_equivalent": {"type": ["boolean", "null"]},
        "reference_result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "candidate_result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "semantic_component_scores": {
          "type": "object",
          "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        },
        "error_category": {
          "type": ["string", "null"],
          "enum": [
            null,
            "preflight",
            "native_validation",
            "unsupported_semantics",
            "agent_protocol",
            "tool_error",
            "sql_policy",
            "sql_parse",
            "sql_bind",
            "sql_runtime",
            "timeout",
            "wrong_result",
            "incomplete_result",
            "internal"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_calls", "database_calls", "total_latency_ms"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "database_calls": {"type": "integer", "minimum": 0},
        "native_service_calls": {"type": "integer", "minimum": 0},
        "total_latency_ms": {"type": "number", "minimum": 0},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "price_snapshot": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["passed", "failed", "unsupported", "invalid", "timeout", "skipped"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

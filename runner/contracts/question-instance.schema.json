{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-layer-benchmark.local/schemas/question-instance.schema.json",
  "title": "Materialized benchmark question instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "question_id",
    "source_template",
    "target_input",
    "orchestrator_only",
    "evaluator_only"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "instance_id": {"type": "string", "pattern": "^q(?:0[1-9]|[1-9][0-9])-[a-z0-9][a-z0-9._-]+$"},
    "question_id": {"type": "string", "pattern": "^q(?:0[1-9]|[1-9][0-9])$"},
    "source_template": {"type": "string", "pattern": "^query[1-9][0-9]?\\.tpl$"},
    "target_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "<[A-Z][A-Z0-9_]*>"}
        }
      }
    },
    "orchestrator_only": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "value"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "type": {"enum": ["integer", "number", "string", "date", "identifier", "list"]},
              "value": {}
            }
          }
        }
      }
    },
    "evaluator_only": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_sql", "expected_statement_count", "result_contract"],
      "properties": {
        "reference_sql": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_statement_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "result_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "order_sensitive", "comparison"],
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "order_sensitive": {"type": "boolean"},
            "max_rows": {"type": ["integer", "null"], "minimum": 1},
            "comparison": {"enum": ["exact_normalized", "numeric_tolerance"]},
            "absolute_tolerance": {"type": "number", "minimum": 0},
            "relative_tolerance": {"type": "number", "minimum": 0}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        }
      }
    }
  }
}

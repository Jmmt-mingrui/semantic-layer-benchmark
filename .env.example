# Copy to .env.local and fill with NEW credentials. Never commit the real key.
BENCHMARK_DATABASE_URL=duckdb:///./data/tpcds/sf1/tpcds.duckdb
BENCHMARK_DATABASE_CATALOG=
BENCHMARK_DATABASE_SCHEMA=main
BENCHMARK_AGENT_PROVIDER=aliyun-maas
BENCHMARK_AGENT_MODEL=deepseek-v4-pro
BENCHMARK_AGENT_ENDPOINT=https://YOUR-SERVICE/compatible-mode/v1
BENCHMARK_AGENT_API_KEY_ENV=BENCHMARK_PRIVATE_API_KEY
BENCHMARK_PRIVATE_API_KEY=REPLACE_WITH_NEW_KEY
BENCHMARK_AGENT_MAX_RETRIES=0
# Keep output >=4096 for reasoning models; reasoning also consumes output budget.
BENCHMARK_AGENT_MAX_TOKENS_FIELD=max_tokens
# Optional: for Skill, identify the actual host implementation revision.
BENCHMARK_SKILL_HOST_REVISION=local-native-skill-host-859d4a2
# Optional: for OKF, set the spec commit you actually reviewed.
# BENCHMARK_OKF_SPEC_COMMIT=FULL_REVIEWED_COMMIT
